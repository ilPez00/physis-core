// RETIRED (2026-09-15): this binary is no longer built (removed from
// Cargo.toml's [[bin]] table, kept only as retained history).
//
// Per docs/plans/2026-09-15-core-pro-development.md §1: "Decide ownership of
// the optional `physis` alias once; do not install two executables with the
// same name or route product commands through Core." Product commands
// (`system`, etc.) moved to physis-pro, and this forwarder could not route to
// them without exactly that violation. Core/Product split decision: Pro owns
// the single `physis` front-door binary; Core ships `physis-core` only.
// See physis-pro/REQUESTS.md (core worker) / core/handoff.md for the request
// this resolves.

//! `physis` — a minimal front door for Physis Core.
//!
//! Historical note (2026-09-14): this binary used to be the front door for two
//! editions, advertising and forwarding to a separate commercial product. That
//! routing is product work and moved with it (see `MOVED_TO_PRODUCT.md`). What
//! remains is a thin forwarder with one help screen, so a newcomer sees the
//! Core surface and nothing else.

use std::process::Command;

/// Mechanisms Core exposes. Kept to one screen deliberately.
const CORE_COMMANDS: &[(&str, &str)] = &[
    ("classify", "Score text against the semiotic grid"),
    ("ontology", "Show ontology stats"),
    ("facet", "Query ontology entries by orthogonal facets"),
    ("scan", "Register a directory's text files as coherence nodes"),
    ("search", "Search recalled nodes by similarity"),
    ("node-search", "Fixed-token-budget search over recalled nodes"),
    ("snapshot", "Coherence snapshot of the persisted graph"),
    ("assert", "Record a verdict on a node: success | inert | failure"),
    ("dream", "Replay low-coherence and failed nodes"),
    ("hypothesis", "Competing hypotheses with evidence and fitness"),
    ("contradiction", "Contradictions and truth maintenance"),
    ("audit", "Chronological epistemic audit log"),
    ("replay", "Reconstruct a belief state at a past timestamp"),
    ("claim", "Is a claim its sentence or its structure?"),
    ("direction", "Did the transformation go the way it was asked to?"),
    ("chain", "Every measured mechanism, composed, with its null"),
    ("context", "Compile bounded context for a query"),
    ("benchmark", "Behavioural compression and structure benchmark"),
    ("demo", "The public playground (bundled corpus, offline)"),
    ("discover", "Ontology gaps and candidate domains"),
    ("model", "Interchangeable model providers"),
    ("ngram", "Interchangeable n-gram tables"),
    ("run", "Config-driven pipeline"),
];

fn main() -> anyhow::Result<()> {
    let args: Vec<String> = std::env::args().skip(1).collect();
    if args.is_empty() {
        print_help();
        return Ok(());
    }
    if matches!(args[0].as_str(), "-h" | "--help" | "help") {
        print_help();
        return Ok(());
    }
    // Forward unparsed: `physis-core` owns the flags, exit codes and stdio.
    let status = Command::new("physis-core").args(&args).status()?;
    if !status.success() {
        std::process::exit(status.code().unwrap_or(1));
    }
    Ok(())
}

fn print_help() {
    println!("physis — deterministic structural engine (Physis Core)\n");
    println!("Mechanisms (all offline; no account, no model required):");
    for (name, about) in CORE_COMMANDS {
        println!("  {name:14} {about}");
    }
    println!("\nThe product surfaces that used to be forwarded from here live in the");
    println!("Physis product repository; Core ships mechanisms, not an application.");
    println!("Run `physis-core --help` for the full Core surface.");
}
